{
  "name": "@hichaochun/made-by-footer",
  "version": "0.1.0",
  "description": "Made by + branded social links footer. Framework-agnostic core with a Vue shell.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "simple-icons": "^16.28.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.0",
    "vite": "^8.0.16",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.38",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
