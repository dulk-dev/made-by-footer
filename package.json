{
  "name": "@hichaochun/made-by-footer",
  "version": "0.3.1",
  "description": "Made by + branded social links footer. Framework-agnostic core with a Vue shell.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dulk-dev/made-by-footer.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json && tsc -p tsconfig.react.json",
    "prepare": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "simple-icons": "^16.28.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.16",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.38",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
