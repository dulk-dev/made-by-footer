{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "rootDir": "./src",
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "types": ["vite/client"]
  },
  "include": ["src/react", "src/core"]
}
